<UserControl x:Class="IEML.App.CurseForgePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PageStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </UserControl.Resources>
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,6"/>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
      <TextBlock Text="CurseForge API 金鑰（自己到 console.curseforge.com 申請，只存在你的電腦、以 Windows 帳號加密）" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,4"/>
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="儲存金鑰" Click="SaveKey_Click" Padding="12,4" Margin="8,0,0,0"/>
        <PasswordBox x:Name="KeyBox"/>
      </DockPanel>
    </StackPanel>
    <TextBlock x:Name="Info" DockPanel.Dock="Top" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
    <DockPanel DockPanel.Dock="Top">
      <Button DockPanel.Dock="Right" Content="匯入本機整合包…" Click="Import_Click" Padding="12,4" Margin="8,0,0,0"/>
      <Button DockPanel.Dock="Right" Content="搜尋" Click="Search_Click" Padding="14,4" Margin="8,0,0,0" IsDefault="True"/>
      <ComboBox DockPanel.Dock="Left" x:Name="KindBox" Width="100" SelectedIndex="0" Margin="0,0,8,0">
        <ComboBoxItem Content="整合包" Tag="Modpack"/>
        <ComboBoxItem Content="模組" Tag="Mod"/>
        <ComboBoxItem Content="光影" Tag="Shader"/>
        <ComboBoxItem Content="資源包" Tag="ResourcePack"/>
      </ComboBox>
      <TextBox x:Name="QueryBox"/>
    </DockPanel>
    <ListBox ItemsSource="{Binding Results}" Margin="0,10,0,0" HorizontalContentAlignment="Stretch">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="0,4">
            <Button DockPanel.Dock="Right" Content="安裝" Click="Install_Click" Padding="12,4" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
              <TextBlock Text="{Binding Description}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
