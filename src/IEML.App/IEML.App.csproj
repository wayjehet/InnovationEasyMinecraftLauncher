<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>IEML.App</RootNamespace>
    <AssemblyName>InnovationEasyMinecraftLauncher</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.3.2</Version>
    <InformationalVersion>1.3.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\IEML.Core\IEML.Core.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
    <!-- 插件系統：JavaScript 沙盒（純 .NET，BSD-2-Clause） -->
    <PackageReference Include="Jint" Version="4.*" />
  </ItemGroup>
  <ItemGroup>
    <!-- 啟動器圖示：exe 圖示（ApplicationIcon）＋視窗／工作列圖示（Resource） -->
    <Resource Include="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- 電繪素材：Assets 資料夾內的檔案會複製到輸出資料夾（使用者也可放進 %AppData%\InnovationEasyLauncher\Assets 覆蓋） -->
    <Content Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
    <!-- 隨附的官方陶瓦聯機（未修改的二進位檔，見 third_party\terracotta\NOTICE.txt）；建置與發佈時複製到輸出資料夾的 third_party\terracotta\ -->
    <Content Include="..\..\third_party\terracotta\*" Link="third_party\terracotta\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- 種子地圖用的 Cubiomes 原生 DLL（native\README.md 說明如何編譯）；有的話建置時複製到輸出資料夾 -->
    <None Include="..\..\native\ieml_cubiomes.dll" Condition="Exists('..\..\native\ieml_cubiomes.dll')" Link="ieml_cubiomes.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
