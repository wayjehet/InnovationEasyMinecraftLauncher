<UserControl x:Class="IEML.App.RoomPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PageStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
      <TextBlock Text="開房（房主）" FontWeight="Bold" FontSize="16"/>
      <Button x:Name="CreateBtn" Content="開房" Click="Create_Click" HorizontalAlignment="Left" Padding="18,6" Margin="0,8,0,0"/>

      <TextBlock Text="加入房間" FontWeight="Bold" FontSize="16" Margin="0,20,0,0"/>
      <TextBlock Text="貼上房主給你的邀請碼（格式：房號:密碼）" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,4"/>
      <DockPanel>
        <Button x:Name="JoinBtn" DockPanel.Dock="Right" Content="加入" Click="Join_Click" Padding="18,4" Margin="8,0,0,0"/>
        <TextBox x:Name="JoinBox"/>
      </DockPanel>

      <Separator Margin="0,18"/>

      <TextBlock Text="目前房間" FontWeight="Bold" FontSize="16"/>
      <Grid Margin="0,8,0,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
        <TextBlock Text="房號" VerticalAlignment="Center" Margin="0,3"/>
        <TextBox x:Name="NameBox" Grid.Column="1" IsReadOnly="True" Margin="0,3"/>
        <Button Grid.Column="2" Content="複製" Tag="Name" Click="Copy_Click" Margin="6,3,0,3" Padding="10,2"/>
        <TextBlock Grid.Row="1" Text="密碼" VerticalAlignment="Center" Margin="0,3"/>
        <TextBox x:Name="SecretBox" Grid.Row="1" Grid.Column="1" IsReadOnly="True" Margin="0,3"/>
        <Button Grid.Row="1" Grid.Column="2" Content="複製" Tag="Secret" Click="Copy_Click" Margin="6,3,0,3" Padding="10,2"/>
        <TextBlock Grid.Row="2" Text="虛擬 IP" VerticalAlignment="Center" Margin="0,3"/>
        <TextBox x:Name="IpBox" Grid.Row="2" Grid.Column="1" IsReadOnly="True" Margin="0,3"/>
        <Button Grid.Row="2" Grid.Column="2" Content="複製" Tag="Ip" Click="Copy_Click" Margin="6,3,0,3" Padding="10,2"/>
        <TextBlock Grid.Row="3" Text="邀請碼" VerticalAlignment="Center" Margin="0,3"/>
        <TextBox x:Name="InviteBox" Grid.Row="3" Grid.Column="1" IsReadOnly="True" Margin="0,3"/>
        <Button Grid.Row="3" Grid.Column="2" Content="複製" Tag="Invite" Click="Copy_Click" Margin="6,3,0,3" Padding="10,2"/>
      </Grid>

      <Button x:Name="StopBtn" Content="停止連線" Click="Stop_Click" HorizontalAlignment="Left" Padding="18,6" Margin="0,12,0,0"/>
      <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
      <TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                 Text="使用方式：房主進入單人世界後選「對區域網路開放」，把邀請碼和遊戲顯示的連接埠給朋友；朋友加入房間後，在多人遊戲用「虛擬 IP:連接埠」直接連線。第一次連線時 Windows 防火牆可能會詢問，請允許。"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
