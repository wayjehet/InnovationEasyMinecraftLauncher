<Window x:Class="IEML.App.NewInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新增實例" Width="380" Height="340" WindowStartupLocation="CenterOwner">
  <StackPanel Margin="16">
    <TextBlock Text="名稱"/>
    <TextBox x:Name="NameBox" Margin="0,2,0,10"/>
    <TextBlock Text="Minecraft 版本"/>
    <ComboBox x:Name="VerBox" Margin="0,2,0,6"/>
    <TextBlock Text="載入器"/>
    <ComboBox x:Name="LoaderBox" Margin="0,2,0,10"/>
    <CheckBox x:Name="SnapBox" Content="包含快照版" Click="Snap_Click" Margin="0,0,0,16"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="建立" Click="Ok_Click" Width="80" Padding="0,6" Margin="0,0,8,0" IsDefault="True"/>
      <Button Content="取消" Width="80" Padding="0,6" IsCancel="True"/>
    </StackPanel>
  </StackPanel>
</Window>
