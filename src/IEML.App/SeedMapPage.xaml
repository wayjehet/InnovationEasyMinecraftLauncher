<UserControl x:Class="IEML.App.SeedMapPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PageStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </UserControl.Resources>
  <DockPanel Margin="16">
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}"/>
    <Grid DockPanel.Dock="Top">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
      </Grid.RowDefinitions>
      <TextBlock Text="種子" VerticalAlignment="Center" Margin="0,0,8,6"/>
      <TextBox x:Name="SeedBox" Grid.Column="1" Margin="0,0,12,6"/>
      <TextBlock Text="MC 版本" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,6"/>
      <TextBox x:Name="VersionBox" Grid.Column="3" Margin="0,0,0,6"/>

      <TextBlock Text="結構" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,6"/>
      <ComboBox x:Name="StructBox" Grid.Row="1" Grid.Column="1" DisplayMemberPath="Display" Margin="0,0,12,6"/>
      <TextBlock Text="半徑（方塊）" Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,6"/>
      <TextBox x:Name="RadiusBox" Grid.Row="1" Grid.Column="3" Text="2000" Margin="0,0,0,6"/>

      <TextBlock Text="中心 X" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,8,6"/>
      <TextBox x:Name="CxBox" Grid.Row="2" Grid.Column="1" Text="0" Margin="0,0,12,6"/>
      <TextBlock Text="中心 Z" Grid.Row="2" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,8,6"/>
      <TextBox x:Name="CzBox" Grid.Row="2" Grid.Column="3" Text="0" Margin="0,0,0,6"/>

      <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,4,0,0">
        <Button Content="搜尋結構" Click="Find_Click" Padding="14,5" Margin="0,0,8,0" IsDefault="True"/>
        <Button Content="查中心點群系" Click="Biome_Click" Padding="14,5" Margin="0,0,8,0"/>
        <Button Content="複製座標" Click="Copy_Click" Padding="14,5"/>
      </StackPanel>
    </Grid>
    <ListBox x:Name="HitList" Margin="0,10,0,0" FontFamily="Consolas"/>
  </DockPanel>
</UserControl>
