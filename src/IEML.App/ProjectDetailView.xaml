<UserControl x:Class="IEML.App.ProjectDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PageStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </UserControl.Resources>
  <!-- 不透明底：蓋住底下的搜尋頁 -->
  <Border Background="{DynamicResource PanelBg}" Padding="4">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Margin="0,0,0,6">
        <Button DockPanel.Dock="Left" Content="← 返回結果" Style="{StaticResource GhostButton}" Padding="10,4" Height="32" Click="Back_Click"/>
        <Border x:Name="IconBorder" DockPanel.Dock="Left" Width="40" Height="40" CornerRadius="6" Margin="12,0,0,0" Visibility="Collapsed"
                Background="#FF141414" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True">
          <Image x:Name="IconImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
        </Border>
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
      <StackPanel Grid.Row="1" Margin="0,0,0,8">
        <TextBlock x:Name="DescText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" MaxHeight="40"/>
        <Button x:Name="DescToggle" Content="▸ 專案說明" Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Padding="10,2" Margin="0,6,0,0"
                Visibility="Collapsed" Click="DescToggle_Click"/>
        <ScrollViewer x:Name="LongDescScroll" Visibility="Collapsed" MaxHeight="150" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
          <TextBlock x:Name="LongDescText" TextWrapping="Wrap" Foreground="#FFCCCCCC" FontSize="12"/>
        </ScrollViewer>
        <TextBlock x:Name="TargetText" Foreground="#FFCCCCCC" Margin="0,6,0,0" TextWrapping="Wrap"/>
        <WrapPanel Margin="0,6,0,0">
          <CheckBox x:Name="MatchOnly" Content="只顯示符合目前實例的版本" IsChecked="True" Margin="0,0,16,0" Checked="Filter_Changed" Unchecked="Filter_Changed"/>
          <CheckBox x:Name="AutoDeps" Content="自動安裝必要前置" IsChecked="True"/>
        </WrapPanel>
      </StackPanel>
      <ListBox x:Name="VersionList" Grid.Row="2" HorizontalContentAlignment="Stretch"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="VersionList_SelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <StackPanel Margin="4">
              <TextBlock Text="{Binding Number}" FontWeight="Bold"/>
              <TextBlock Text="{Binding Sub}" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="3" Margin="0,8,0,0">
        <TextBlock x:Name="ChangelogText" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" MaxHeight="48" Margin="0,0,0,6"/>
        <TextBlock x:Name="RequiredText" TextWrapping="Wrap" Foreground="#FFCCCCCC"/>
        <ItemsControl x:Name="DepList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,4,0,0">
                <ComboBox DockPanel.Dock="Right" Style="{StaticResource DarkComboBox}" Width="230" Height="28" Margin="10,0,0,0" ItemsSource="{Binding Choices}"
                          SelectedItem="{Binding Choice, Mode=TwoWay}" DropDownOpened="DepCombo_DropDownOpened" SelectionChanged="DepCombo_SelectionChanged"
                          ToolTip="預設自動挑最新的相容版本；展開可指定這個前置模組的版本"/>
                <TextBlock Text="{Binding Label}" Visibility="{Binding RequiredVisibility}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected, Mode=TwoWay}" Visibility="{Binding OptionalVisibility}" VerticalAlignment="Center"/>
              </DockPanel>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Button x:Name="InstallButton" Content="安裝此版本" Height="36" FontWeight="Bold" Margin="0,8,0,0" IsEnabled="False" Click="Install_Click"/>
        <TextBlock x:Name="StatusText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
