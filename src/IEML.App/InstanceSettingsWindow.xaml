<Window x:Class="IEML.App.InstanceSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="實例設置" Width="460" Height="820" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="保存" Click="Save_Click" Width="80" Padding="0,6" Margin="0,0,8,0" IsDefault="True"/>
      <Button Content="取消" Click="Cancel_Click" Width="80" Padding="0,6" IsCancel="True"/>
    </StackPanel>
    <StackPanel>
      <TextBlock Text="名稱"/>
      <TextBox Text="{Binding Config.Name, Mode=TwoWay}" Margin="0,2,0,10"/>
      <TextBlock Text="最大記憶體 (MB)"/>
      <TextBox Text="{Binding Config.MaxMemoryMb, Mode=TwoWay}" Margin="0,2,0,10"/>
      <TextBlock Text="Minecraft 版本"/>
      <TextBox x:Name="McBox" Text="{Binding Config.McVersion, Mode=TwoWay}" Margin="0,2,0,10" LostFocus="McBox_LostFocus"/>
      <TextBlock Text="載入器"/>
      <ComboBox x:Name="LoaderBox" Margin="0,2,0,10" SelectionChanged="LoaderBox_Changed"/>
      <TextBlock Text="載入器版本"/>
      <DockPanel Margin="0,2,0,2">
        <Button DockPanel.Dock="Right" Content="重新整理" Click="RefreshLoaderVer_Click" Padding="10,2" Margin="6,0,0,0"/>
        <ComboBox x:Name="LoaderVerBox" IsEditable="True"/>
      </DockPanel>
      <TextBlock x:Name="LoaderHint" Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
      <TextBlock Text="Java 路徑（留空＝自動）"/>
      <DockPanel Margin="0,2,0,10">
        <Button DockPanel.Dock="Right" Content="選擇…" Click="PickJava_Click" Padding="10,2" Margin="6,0,0,0"/>
        <TextBox x:Name="JavaBox" Text="{Binding Config.JavaPath, Mode=TwoWay}"/>
      </DockPanel>
      <TextBlock Text="額外 JVM 參數"/>
      <TextBox Text="{Binding Config.ExtraJvmArgs, Mode=TwoWay}" Margin="0,2,0,16"/>
      <DockPanel Margin="0,0,0,6">
        <Button DockPanel.Dock="Right" Content="＋ 新增帳號卡片" Click="AddCard_Click" Padding="8,2"/>
        <TextBlock Text="快速啟動卡片（會顯示在主畫面）" FontWeight="Bold" VerticalAlignment="Center"/>
      </DockPanel>
      <ItemsControl ItemsSource="{Binding Cards}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="刪除" Click="RemoveCard_Click" Margin="8,0,0,0" Padding="8,2"/>
                <ComboBox ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=Window}}"
                          DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding AccountId, Mode=TwoWay}"/>
              </DockPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </DockPanel>
</Window>
