<UserControl x:Class="IEML.App.NewInstancePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PageStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </UserControl.Resources>
  <StackPanel>
    <TextBlock Text="名稱" Foreground="{DynamicResource MutedBrush}"/>
    <TextBox x:Name="NameBox" Margin="0,2,0,10"/>
    <TextBlock Text="Minecraft 版本" Foreground="{DynamicResource MutedBrush}"/>
    <ComboBox x:Name="VerBox" Margin="0,2,0,6"/>
    <TextBlock Text="載入器" Foreground="{DynamicResource MutedBrush}"/>
    <ComboBox x:Name="LoaderBox" Margin="0,2,0,10"/>
    <TextBlock Text="實例目錄（新實例建立在這裡）" Foreground="{DynamicResource MutedBrush}"/>
    <DockPanel Margin="0,2,0,10">
      <Button DockPanel.Dock="Right" Content="＋ 新增目錄" Click="AddRoot_Click" Padding="10,4" Margin="8,0,0,0" Style="{StaticResource GhostButton}"/>
      <ComboBox x:Name="RootBox"/>
    </DockPanel>
    <CheckBox x:Name="SnapBox" Content="包含快照版" Click="Snap_Click" Margin="0,0,0,16"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" Click="Cancel_Click" Width="80" Height="32" Margin="0,0,8,0" Style="{StaticResource GhostButton}"/>
      <Button Content="建立" Click="Ok_Click" Width="80" Height="32"/>
    </StackPanel>
  </StackPanel>
</UserControl>
