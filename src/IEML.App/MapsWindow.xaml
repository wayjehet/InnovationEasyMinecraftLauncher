<Window x:Class="IEML.App.MapsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="地圖" Width="720" Height="660" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <TextBlock x:Name="Info" DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,8" TextWrapping="Wrap"/>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
      <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,6"/>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap"/>
    </StackPanel>

    <TabControl>
      <!-- ===== 我的地圖 ===== -->
      <TabItem Header="我的地圖">
        <DockPanel Margin="0,10,0,0">
          <WrapPanel DockPanel.Dock="Top">
            <Button Content="匯入 zip…" Click="ImportZip_Click" Padding="12,4" Margin="0,0,6,6"/>
            <Button Content="匯入資料夾…" Click="ImportFolder_Click" Padding="12,4" Margin="0,0,6,6"/>
            <Button Content="開啟 saves 資料夾" Click="OpenFolder_Click" Padding="12,4" Margin="0,0,6,6"/>
            <Button Content="重新整理" Click="Refresh_Click" Padding="12,4" Margin="0,0,6,6"/>
          </WrapPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,2,0,0">
            <Button DockPanel.Dock="Right" Content="下載並匯入" Click="Url_Click" Padding="12,4" Margin="8,0,0,0"/>
            <TextBox x:Name="UrlBox" ToolTip="必須是 .zip 檔案的直接連結（不是網頁）"/>
          </DockPanel>
          <TextBlock DockPanel.Dock="Top" Foreground="Gray" FontSize="11" Margin="0,2,0,6" Text="↑ 貼上地圖 zip 的直接下載連結。Planet Minecraft 等網站請先用瀏覽器下載，再按「匯入 zip」。"/>
          <ListBox ItemsSource="{Binding Worlds}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,4">
                  <Button DockPanel.Dock="Right" Content="刪除" Click="Delete_Click" Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" Content="備份" Click="Backup_Click" Padding="10,3" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Name}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Foreground="Gray" FontSize="12">
                      <Run Text="{Binding SizeText, Mode=OneWay}"/><Run Text="　最後遊玩 "/><Run Text="{Binding DateText, Mode=OneWay}"/>
                    </TextBlock>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <!-- ===== CurseForge 地圖 ===== -->
      <TabItem Header="CurseForge 地圖">
        <DockPanel Margin="0,10,0,0">
          <TextBlock x:Name="CfNote" DockPanel.Dock="Top" Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="搜尋" Click="Search_Click" Padding="14,4" Margin="8,0,0,0" IsDefault="True"/>
            <TextBox DockPanel.Dock="Right" x:Name="McBox" Width="90" Margin="8,0,0,0" ToolTip="Minecraft 版本（空白＝全部）"/>
            <TextBox x:Name="QueryBox"/>
          </DockPanel>
          <Button DockPanel.Dock="Bottom" x:Name="MoreBtn" Content="載入更多" Click="More_Click" Padding="14,4" Margin="0,8,0,0" Visibility="Collapsed"/>
          <ListBox ItemsSource="{Binding Hits}" Margin="0,8,0,0" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,4">
                  <Button DockPanel.Dock="Right" Content="下載並匯入" Click="Install_Click" Padding="10,4" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  <Image DockPanel.Dock="Left" Source="{Binding IconUrl}" Width="48" Height="48" Margin="0,0,10,0" VerticalAlignment="Top"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Description}" Foreground="Gray" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DownloadsText}" Foreground="#FF00AAAA" FontSize="11"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
