<UserControl x:Class="IEML.App.InstanceSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}">
  <UserControl.Resources>
    <!-- 只作用在這一頁：深色輸入框／勾選框／唯讀下拉／分頁（可編輯下拉仍是預設淺色） -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FF131313"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource DarkComboBox}"/>
    <Style TargetType="TabControl" BasedOn="{StaticResource DarkTabControl}"/>
    <Style TargetType="TabItem" BasedOn="{StaticResource DarkTabItem}"/>
    <Style x:Key="Label" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </UserControl.Resources>
  <DockPanel>
    <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
        <Button Content="取消" Click="Cancel_Click" Width="80" Height="32" Margin="0,0,8,0" Style="{StaticResource GhostButton}"/>
        <Button Content="保存" Click="Save_Click" Width="80" Height="32"/>
      </StackPanel>
      <TextBlock Style="{StaticResource Label}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                 Text="「基本」「快捷卡片」要按保存才生效；模組、光影、資源包的安裝／刪除會直接生效。"/>
    </DockPanel>

    <TabControl x:Name="Tabs" SelectionChanged="Tabs_Changed">
      <!-- ===== 基本 ===== -->
      <TabItem Header="基本" Tag="basic">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,12,0">
            <TextBlock Style="{StaticResource Label}" Text="名稱"/>
            <TextBox Text="{Binding Config.Name, Mode=TwoWay}" Margin="0,2,0,10"/>
            <TextBlock Style="{StaticResource Label}" Text="最大記憶體 (MB)"/>
            <TextBox Text="{Binding Config.MaxMemoryMb, Mode=TwoWay}" Margin="0,2,0,10"/>
            <TextBlock Style="{StaticResource Label}" Text="Minecraft 版本"/>
            <TextBox x:Name="McBox" Text="{Binding Config.McVersion, Mode=TwoWay}" Margin="0,2,0,10" LostFocus="McBox_LostFocus"/>
            <TextBlock Style="{StaticResource Label}" Text="載入器"/>
            <ComboBox x:Name="LoaderBox" Margin="0,2,0,10" SelectionChanged="LoaderBox_Changed"/>
            <TextBlock Style="{StaticResource Label}" Text="載入器版本"/>
            <DockPanel Margin="0,2,0,2">
              <Button DockPanel.Dock="Right" Content="重新整理" Click="RefreshLoaderVer_Click" Padding="10,2" Margin="6,0,0,0"/>
              <ComboBox x:Name="LoaderVerBox" IsEditable="True" Style="{x:Null}"/>
            </DockPanel>
            <TextBlock x:Name="LoaderHint" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,10"/>
            <TextBlock Style="{StaticResource Label}" Text="Java 路徑（留空＝自動）"/>
            <DockPanel Margin="0,2,0,10">
              <Button DockPanel.Dock="Right" Content="選擇…" Click="PickJava_Click" Padding="10,2" Margin="6,0,0,0"/>
              <TextBox x:Name="JavaBox" Text="{Binding Config.JavaPath, Mode=TwoWay}"/>
            </DockPanel>
            <TextBlock Style="{StaticResource Label}" Text="額外 JVM 參數"/>
            <TextBox Text="{Binding Config.ExtraJvmArgs, Mode=TwoWay}" Margin="0,2,0,10"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- ===== 內容：第一次切過去才建立，避免一開頁就連線三次 ===== -->
      <TabItem Header="模組" Tag="Mod"><ContentControl x:Name="ModHost" Margin="0,8,0,0"/></TabItem>
      <TabItem Header="光影" Tag="Shader"><ContentControl x:Name="ShaderHost" Margin="0,8,0,0"/></TabItem>
      <TabItem Header="資源包" Tag="ResourcePack"><ContentControl x:Name="PackHost" Margin="0,8,0,0"/></TabItem>

      <!-- ===== 伺服器（這個實例記錄的清單） ===== -->
      <TabItem Header="伺服器" Tag="servers">
        <DockPanel Margin="0,12,0,0">
          <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="新增" Click="AddServer_Click" Padding="14,4" Margin="8,0,0,0"/>
            <TextBox DockPanel.Dock="Left" x:Name="SrvNameBox" Width="140" Margin="0,0,8,0" ToolTip="名稱（可留空）"/>
            <TextBox x:Name="SrvAddrBox" ToolTip="位址，例如 mc.example.com 或 1.2.3.4:25566"/>
          </DockPanel>
          <DockPanel DockPanel.Dock="Top" Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="更新狀態" Click="PingAll_Click" Padding="10,3"/>
            <TextBlock x:Name="SrvHint" Style="{StaticResource Label}" VerticalAlignment="Center" TextWrapping="Wrap"
                       Text="★＝每次啟動這個實例都自動加入。「啟動並加入」會先保存這一頁，再關閉設置頁並直接啟動、進入該伺服器（只這一次）。"/>
          </DockPanel>
          <ListBox ItemsSource="{Binding Servers}" Margin="0,8,0,0" HorizontalContentAlignment="Stretch"
                   Background="Transparent" BorderBrush="{StaticResource LineBrush}" Foreground="{StaticResource TextBrush}"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,4">
                  <Button DockPanel.Dock="Right" Content="啟動並加入" Click="JoinServer_Click" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" Content="刪除" Click="DelServer_Click" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" Content="{Binding AutoText}" Click="ToggleAuto_Click" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  <Button DockPanel.Dock="Right" Content="複製" Click="CopyServer_Click" Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"/>
                  <StackPanel>
                    <TextBlock FontWeight="Bold"><Run Text="{Binding Star, Mode=OneWay}" Foreground="{StaticResource AccentBrush}"/><Run Text="{Binding Name, Mode=OneWay}"/></TextBlock>
                    <TextBlock Text="{Binding Address}" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <!-- ===== 快捷卡片 ===== -->
      <TabItem Header="快捷卡片" Tag="cards">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="0,12,12,0">
            <DockPanel Margin="0,0,0,8">
              <Button DockPanel.Dock="Right" Content="＋ 新增帳號卡片" Click="AddCard_Click" Padding="10,4"/>
              <TextBlock Text="會顯示在主畫面的卡片（每張綁一個帳號）" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Cards}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                    <DockPanel>
                      <Button DockPanel.Dock="Right" Content="刪除" Click="RemoveCard_Click" Margin="8,0,0,0" Padding="8,2"/>
                      <ComboBox ItemsSource="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedValue="{Binding AccountId, Mode=TwoWay}"/>
                    </DockPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
