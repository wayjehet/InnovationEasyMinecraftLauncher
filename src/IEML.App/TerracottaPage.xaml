<UserControl x:Class="IEML.App.TerracottaPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PageStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
      <!-- 依陶瓦聯機的 AGPL 例外條款，必須在介面明顯處標示其版權資訊，請勿移除 -->
      <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock FontWeight="Bold" Text="聯機由 Terracotta | 陶瓦聯機 提供"/>
          <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"
                     Text="Copyright © burningtnt，AGPL-3.0-or-later。基於 EasyTier。房間碼可與 HMCL、PCL-CE 等已接入陶瓦的啟動器互通。"/>
          <TextBlock Margin="0,4,0,0"><Hyperlink NavigateUri="https://github.com/burningtnt/Terracotta" RequestNavigate="Link_Navigate">github.com/burningtnt/Terracotta</Hyperlink></TextBlock>
        </StackPanel>
      </Border>

      <TextBlock Text="玩家名稱（顯示在房間成員裡）"/>
      <TextBox x:Name="PlayerBox" Margin="0,4,0,12" Text="Player"/>

      <TextBlock Text="開房（房主）" FontWeight="Bold" FontSize="16"/>
      <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,6"
                 Text="先啟動遊戲、進入單人世界並選「對區域網路開放」，再按開房，陶瓦會自動掃描到你的世界。"/>
      <Button x:Name="HostBtn" Content="開房" Click="Host_Click" HorizontalAlignment="Left" Padding="18,6"/>

      <TextBlock Text="加入房間" FontWeight="Bold" FontSize="16" Margin="0,18,0,0"/>
      <DockPanel Margin="0,6,0,0">
        <Button x:Name="JoinBtn" DockPanel.Dock="Right" Content="加入" Click="Join_Click" Padding="18,4" Margin="8,0,0,0"/>
        <TextBox x:Name="CodeBox" ToolTip="房間碼，格式 U/XXXX-XXXX-XXXX-XXXX"/>
      </DockPanel>

      <Separator Margin="0,18"/>

      <TextBlock Text="目前狀態" FontWeight="Bold" FontSize="16"/>
      <TextBlock x:Name="StateText" TextWrapping="Wrap" Margin="0,6,0,0" Text="尚未連線"/>

      <Grid x:Name="RoomRow" Margin="0,10,0,0" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="房間碼" VerticalAlignment="Center"/>
        <TextBox x:Name="RoomBox" Grid.Column="1" IsReadOnly="True"/>
        <Button Grid.Column="2" Content="複製" Click="CopyRoom_Click" Margin="6,0,0,0" Padding="10,2"/>
      </Grid>
      <Grid x:Name="UrlRow" Margin="0,6,0,0" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <TextBlock Text="直連位址" VerticalAlignment="Center"/>
        <TextBox x:Name="UrlBox" Grid.Column="1" IsReadOnly="True"/>
        <Button Grid.Column="2" Content="複製" Click="CopyUrl_Click" Margin="6,0,0,0" Padding="10,2"/>
      </Grid>

      <TextBlock Text="房間成員" Margin="0,12,0,0"/>
      <ListBox x:Name="MemberList" Height="90" Margin="0,4,0,0"/>

      <Button x:Name="ResetBtn" Content="返回待機（離開房間）" Click="Reset_Click" HorizontalAlignment="Left" Padding="14,5" Margin="0,12,0,0"/>
      <TextBlock x:Name="InfoText" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
