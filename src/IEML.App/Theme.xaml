<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:IEML.App">
  <!-- 配色比照 InnovationExtremeStudio 網頁：深色底、#1C1C1C 卡片、#333 邊框、青色 #00FFFF 強調。
       所有按鈕都由程式繪製；若在 Assets 放了對應的 PNG，仍會優先顯示圖片。 -->
  <local:AssetConverter x:Key="Asset"/>
  <local:HideWhenBakedConverter x:Key="HideWhenBaked"/>
  <SolidColorBrush x:Key="WindowBg" Color="#FF0F0F0F"/>
  <SolidColorBrush x:Key="PanelBg" Color="#FF1C1C1C"/>
  <SolidColorBrush x:Key="LineBrush" Color="#FF333333"/>
  <SolidColorBrush x:Key="TextBrush" Color="#FFFFFFFF"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#FF888888"/>
  <SolidColorBrush x:Key="AccentBrush" Color="#FF00FFFF"/>
  <SolidColorBrush x:Key="OnAccentBrush" Color="#FF0F0F0F"/>

  <DropShadowEffect x:Key="GlowEffect" Color="#00FFFF" BlurRadius="16" ShadowDepth="0" Opacity="0.85"/>
  <DropShadowEffect x:Key="SoftGlowEffect" Color="#00FFFF" BlurRadius="14" ShadowDepth="0" Opacity="0.25"/>

  <!-- 主按鈕：青底黑字粗體、圓角 5，滑過發光並上浮（同網頁的 button） -->
  <Style x:Key="ArtButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="Tt" Y="0"/></TransformGroup></Grid.RenderTransform>
            <local:SkinBorder x:Name="Art" Background="{StaticResource AccentBrush}" CornerRadius="5"
                              Slot="{Binding (local:ArtProps.File), RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=btn_primary, FallbackValue=btn_primary}"/>
            <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,6">
              <ContentPresenter.Visibility>
                <MultiBinding Converter="{StaticResource HideWhenBaked}">
          <Binding Path="(local:ArtProps.File)" RelativeSource="{RelativeSource TemplatedParent}"/>
          <Binding Path="HasImage" ElementName="Art"/>
        </MultiBinding>
              </ContentPresenter.Visibility>
            </ContentPresenter>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Art" Property="State" Value="_hover"/>
              <Setter TargetName="Root" Property="Effect" Value="{StaticResource GlowEffect}"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Tt" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Tt" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Art" Property="State" Value="_pressed"/>
              <Setter TargetName="Root" Property="Opacity" Value="0.75"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="0.96" Duration="0:0:0.06"/>
                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="0.96" Duration="0:0:0.06"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"/>
                <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Art" Property="State" Value="_disabled"/>
              <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 沒指定樣式的一般按鈕（音樂播放控制、各視窗內的按鈕）也套用同一個外觀 -->
  <Style TargetType="Button" BasedOn="{StaticResource ArtButton}">
    <Setter Property="Padding" Value="10,5"/>
  </Style>

  <!-- 卡片按鈕：#1C1C1C 底、#333 邊框，滑過邊框變青色並微發光（同網頁的 .card）；內容永遠顯示 -->
  <Style x:Key="CardButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><TransformGroup><ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="Tt" Y="0"/></TransformGroup></Grid.RenderTransform>
            <Border x:Name="Fallback" Visibility="Collapsed" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="10"/>
            <Image x:Name="Art" Stretch="Fill"
                   Source="{Binding (local:ArtProps.File), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Asset}}"/>
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Source, ElementName=Art}" Value="{x:Null}">
              <Setter TargetName="Fallback" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Fallback" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="Root" Property="Effect" Value="{StaticResource SoftGlowEffect}"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Tt" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.12">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Tt" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.18">
                  <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                </DoubleAnimation>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.8"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- 右欄選單鈕：純文字（同草圖），滑過變青色並有左側亮條 -->
  <Style x:Key="NavButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent">
            <local:SkinBorder x:Name="Art" Slot="{Binding (local:ArtProps.File), RelativeSource={RelativeSource TemplatedParent}}"/>
            <Border x:Name="Bar" HorizontalAlignment="Left" Width="3" Margin="0,8" CornerRadius="2"
                    Background="{StaticResource AccentBrush}" Opacity="0">
              <Border.Visibility>
                <MultiBinding Converter="{StaticResource HideWhenBaked}">
          <Binding Path="(local:ArtProps.File)" RelativeSource="{RelativeSource TemplatedParent}"/>
          <Binding Path="HasImage" ElementName="Art"/>
        </MultiBinding>
              </Border.Visibility>
            </Border>
            <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,2" RenderTransformOrigin="0.5,0.5">
              <ContentPresenter.Visibility>
                <MultiBinding Converter="{StaticResource HideWhenBaked}">
          <Binding Path="(local:ArtProps.File)" RelativeSource="{RelativeSource TemplatedParent}"/>
          <Binding Path="HasImage" ElementName="Art"/>
        </MultiBinding>
              </ContentPresenter.Visibility>
              <ContentPresenter.RenderTransform><ScaleTransform x:Name="NavSc" ScaleX="1" ScaleY="1"/></ContentPresenter.RenderTransform>
            </ContentPresenter>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Art" Property="State" Value="_hover"/>
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                <DoubleAnimation Storyboard.TargetName="NavSc" Storyboard.TargetProperty="ScaleX" To="1.1" Duration="0:0:0.15"/>
                <DoubleAnimation Storyboard.TargetName="NavSc" Storyboard.TargetProperty="ScaleY" To="1.1" Duration="0:0:0.15"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="Bar" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="NavSc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="NavSc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.2"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Art" Property="State" Value="_pressed"/>
              <Setter TargetName="Root" Property="Opacity" Value="0.7"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Art" Property="State" Value="_disabled"/>
              <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 程式繪製的向量圖標：線條顏色跟著按鈕文字色走（滑過會一起變青色），任何縮放都清楚 -->
  <Style x:Key="NavIcon" TargetType="Path">
    <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
    <Setter Property="StrokeThickness" Value="2.2"/>
    <Setter Property="StrokeStartLineCap" Value="Round"/>
    <Setter Property="StrokeEndLineCap" Value="Round"/>
    <Setter Property="StrokeLineJoin" Value="Round"/>
  </Style>
  <!-- ===== 主畫面（照預覽圖）用的樣式 ===== -->
  <!-- 描邊按鈕：深底、#333 邊框，滑過邊框變青色（預覽圖的「實例設置」「設置」） -->
  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent">
            <local:SkinBorder x:Name="Bd" Background="#FF141414" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5"
                              Slot="{Binding (local:ArtProps.File), RelativeSource={RelativeSource TemplatedParent}, TargetNullValue=btn_ghost, FallbackValue=btn_ghost}"/>
            <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,6">
              <ContentPresenter.Visibility>
                <MultiBinding Converter="{StaticResource HideWhenBaked}">
          <Binding Path="(local:ArtProps.File)" RelativeSource="{RelativeSource TemplatedParent}"/>
          <Binding Path="HasImage" ElementName="Bd"/>
        </MultiBinding>
              </ContentPresenter.Visibility>
            </ContentPresenter>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="Bd" Property="State" Value="_hover"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="State" Value="_pressed"/>
              <Setter TargetName="Root" Property="Opacity" Value="0.8"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Bd" Property="State" Value="_disabled"/>
              <Setter TargetName="Root" Property="Opacity" Value="0.4"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 沒有外觀的按鈕（頭像用） -->
  <Style x:Key="FlatButton" TargetType="Button">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent"><ContentPresenter/></Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.85"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 深色細進度條（常駐顯示，閒置時只有軌道） -->
  <Style x:Key="DarkProgress" TargetType="ProgressBar">
    <Setter Property="Height" Value="6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Grid>
            <local:SkinBorder x:Name="PART_Track" Slot="progress_track" Background="#FF2A2A2A" CornerRadius="3"/>
            <local:SkinBorder x:Name="PART_Indicator" Slot="progress_fill" HorizontalAlignment="Left" Background="{StaticResource AccentBrush}" CornerRadius="3" ClipToBounds="True">
              <Border x:Name="Shimmer" Width="70" HorizontalAlignment="Left" IsHitTestVisible="False">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#00FFFFFF" Offset="0"/><GradientStop Color="#66FFFFFF" Offset="0.5"/><GradientStop Color="#00FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Border.RenderTransform><TranslateTransform x:Name="ShimmerTt" X="-70"/></Border.RenderTransform>
              </Border>
            </local:SkinBorder>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding HasImage, ElementName=PART_Indicator}" Value="True">
              <Setter TargetName="Shimmer" Property="Visibility" Value="Collapsed"/>
            </DataTrigger>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard><Storyboard RepeatBehavior="Forever">
                <DoubleAnimation Storyboard.TargetName="ShimmerTt" Storyboard.TargetProperty="X" From="-70" To="340" Duration="0:0:1.4"/>
              </Storyboard></BeginStoryboard>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 深色下拉選單（只給「使用帳號」這種唯讀下拉用；可編輯的下拉不要套） -->
  <Style x:Key="DarkComboBoxItem" TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FF2A2A2A"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DarkComboBox" TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <local:SkinBorder x:Name="Bd" Slot="dropdown" Background="#FF131313" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="5"/>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter IsHitTestVisible="False" Margin="10,7,30,7" VerticalAlignment="Center" HorizontalAlignment="Left"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
            <Path IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                  Data="M0,0 L4,4 L8,0" Stroke="{StaticResource MutedBrush}" StrokeThickness="1.6"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
              <local:SkinBorder Slot="menu" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="3" Margin="0,2,0,0">
                <ScrollViewer><StackPanel IsItemsHost="True"/></ScrollViewer>
              </local:SkinBorder>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 右鍵／下拉選單（「更多」按鈕的選單）：深色底、白字，滑過變青色 -->
  <Style TargetType="ContextMenu">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <local:SkinBorder Slot="menu" Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="4">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </local:SkinBorder>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Padding" Value="14,7"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="#FF2A2A2A"/>
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 深色分頁（實例設置頁、內容頁用；需要時用 BasedOn 或明確指定，不是全域） -->
  <Style x:Key="DarkTabItem" TargetType="TabItem">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabItem">
          <local:SkinBorder x:Name="Bd" Slot="tab" Padding="14,8" Margin="0,0,4,0" Background="Transparent" BorderThickness="0,0,0,2" BorderBrush="Transparent">
            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </local:SkinBorder>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/></Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
              <Setter TargetName="Bd" Property="Slot" Value="tab_selected"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DarkTabControl" TargetType="TabControl">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TabControl">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
              <TabPanel IsItemsHost="True"/>
            </Border>
            <ContentPresenter ContentSource="SelectedContent"/>
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
