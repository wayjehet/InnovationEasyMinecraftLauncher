<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:IEML.App">
  <!-- 換皮集中在這裡：顏色改這幾個 Brush；若你的背景圖已經畫好面板外框，把 PanelBg / LineBrush 改成 Transparent -->
  <local:AssetConverter x:Key="Asset"/>
  <SolidColorBrush x:Key="WindowBg" Color="#FF14181D"/>
  <SolidColorBrush x:Key="PanelBg" Color="#990B0E12"/>
  <SolidColorBrush x:Key="LineBrush" Color="#55FFFFFF"/>
  <SolidColorBrush x:Key="TextBrush" Color="#FFF2F2F2"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#FFA8B0B8"/>

  <!-- 圖片按鈕：有圖就只顯示圖（圖上自己畫文字）；沒圖就顯示預設框與文字 -->
  <Style x:Key="ArtButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent">
            <Border x:Name="Fallback" Visibility="Collapsed" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6"/>
            <Image x:Name="Art" Stretch="Fill"
                   Source="{Binding (local:ArtProps.File), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Asset}}"/>
            <ContentPresenter x:Name="Label" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="6,2"/>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Source, ElementName=Art}" Value="{x:Null}">
              <Setter TargetName="Fallback" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Label" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.65"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 卡片按鈕：底圖（有就用）＋ 內容永遠顯示（實例名稱、帳號名稱、頭像等） -->
  <Style x:Key="CardButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="Root" Background="Transparent">
            <Border x:Name="Fallback" Visibility="Collapsed" Background="{StaticResource PanelBg}"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8"/>
            <Image x:Name="Art" Stretch="Fill"
                   Source="{Binding (local:ArtProps.File), RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Asset}}"/>
            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
          </Grid>
          <ControlTemplate.Triggers>
            <DataTrigger Binding="{Binding Source, ElementName=Art}" Value="{x:Null}">
              <Setter TargetName="Fallback" Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.65"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Root" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
