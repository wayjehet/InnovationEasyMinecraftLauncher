<Window x:Class="IEML.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IEML.App"
        Title="Innovation Easy Minecraft Launcher · Beta" Width="980" Height="640" MinWidth="784" MinHeight="512"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource TextBrush}">
  <Grid>
    <!-- 程式繪製的簡潔背景（同網頁橫幅的深綠漸層）；Assets\background.png 存在時會蓋過它 -->
    <Rectangle IsHitTestVisible="False">
      <Rectangle.Fill>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FF0F1F1A" Offset="0"/>
          <GradientStop Color="#FF12302A" Offset="0.5"/>
          <GradientStop Color="#FF0F0F0F" Offset="1"/>
        </LinearGradientBrush>
      </Rectangle.Fill>
    </Rectangle>
    <!-- 背景圖：Assets\background.png（撐滿並裁掉多出的邊） -->
    <Image Stretch="UniformToFill" Source="{Binding Converter={StaticResource Asset}, ConverterParameter=background.png}"/>

    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="311*" MinWidth="240"/>
        <ColumnDefinition Width="551*"/>
        <ColumnDefinition Width="117*" MinWidth="96"/>
      </Grid.ColumnDefinitions>

      <!-- 單一外框＋兩條分隔線（照草圖） -->
      <Border Grid.ColumnSpan="3" CornerRadius="10" Background="{StaticResource PanelBg}"
              BorderBrush="{StaticResource LineBrush}" BorderThickness="1"/>
      <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right" Margin="0,1" Fill="{StaticResource LineBrush}"/>
      <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Right" Margin="0,1" Fill="{StaticResource LineBrush}"/>

      <!-- ============ 左欄：標誌／頭像／帳號／狀態／啟動 ============ -->
      <Border Grid.Column="0" Margin="0" Padding="14" CornerRadius="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- 標誌：有 logo.png 就顯示圖；沒有就顯示文字（E 是青色）加 Beta 徽章 -->
          <Grid Grid.Row="0" Height="44">
            <Image x:Name="Logo" HorizontalAlignment="Left" Stretch="Uniform"/>
            <StackPanel x:Name="LogoText" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock FontSize="28" FontWeight="Bold"><Run Text="I"/><Run Text="E" Foreground="{StaticResource AccentBrush}"/><Run Text="ML"/></TextBlock>
              <Border Margin="8,6,0,0" Padding="6,1" CornerRadius="4" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" VerticalAlignment="Center">
                <TextBlock Text="Beta" FontSize="10" Foreground="{StaticResource MutedBrush}"/>
              </Border>
            </StackPanel>
          </Grid>

          <!-- 頭像（圓形青色外圈）＋目前實例：點頭像開帳號管理；正版帳號顯示皮膚頭像，否則顯示名字首字 -->
          <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Width="64" Height="64" Style="{StaticResource FlatButton}"
                    Command="{Binding OpenAccountsCommand}" ToolTip="帳號管理">
              <Grid>
                <Ellipse Fill="#FF263A36" Stroke="{StaticResource AccentBrush}" StrokeThickness="2"/>
                <TextBlock Text="{Binding AvatarInitial}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Margin="3"><Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
              </Grid>
            </Button>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding SelectedInstance.Name}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectedInstance.McVersion}" Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text=" · " Foreground="{StaticResource MutedBrush}"/>
                <TextBlock Text="{Binding SelectedInstance.Loader}" Foreground="{StaticResource MutedBrush}"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="2" Margin="0,16,0,8">
            <TextBlock Text="使用帳號" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
            <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding Accounts}" DisplayMemberPath="DisplayName"
                      SelectedItem="{Binding SelectedAccount}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Status}" Margin="0,16,0,6" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            <ProgressBar Style="{StaticResource DarkProgress}" Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"/>
          </StackPanel>

          <Button Grid.Row="3" Height="56" Margin="0,0,0,8" Content="啟動" FontSize="22" FontWeight="Bold"
                  Style="{StaticResource ArtButton}" local:ArtProps.File="btn_launch.png"
                  Command="{Binding LaunchCommand}"/>

          <Grid Grid.Row="4" Height="40">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="0,0,4,0" Content="實例設置" Style="{StaticResource GhostButton}"
                    Command="{Binding OpenSettingsCommand}"/>
            <Button Grid.Column="1" Margin="4,0,0,0" Content="實例選擇" Style="{StaticResource GhostButton}"
                    Command="{Binding OpenInstancePickerCommand}"/>
          </Grid>
        </Grid>
      </Border>

      <!-- ============ 中欄：快捷啟動卡片（數量不限，超過會捲動） ============ -->
      <Border Grid.Column="1" Margin="0" Padding="14" CornerRadius="10">
        <Grid>
          <!-- 畫布：卡片可以拖到任何位置（位置會存起來）；點一下啟動，拖拉超過一小段距離才算移動 -->
          <ItemsControl x:Name="CardsHost" ItemsSource="{Binding Cards}" ClipToBounds="True" SizeChanged="CardsHost_SizeChanged">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- 小卡片：上面是頭像＋名稱（拖這一塊可移動），下面是「啟動」「設置」兩顆按鈕 -->
                <Border Width="210" Height="104" CornerRadius="8" Background="{StaticResource PanelBg}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                  <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="Transparent" Cursor="SizeAll" ToolTip="拖拉移動位置"
                            PreviewMouseLeftButtonDown="Card_Down" PreviewMouseMove="Card_Move" PreviewMouseLeftButtonUp="Card_Up">
                      <DockPanel>
                        <Grid DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,10,0">
                          <Ellipse Fill="#FF263A36"/>
                          <TextBlock Text="{Binding Initial}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding InstanceName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding AccountName}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <Grid Grid.Row="1" VerticalAlignment="Bottom" Height="30">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                      <Button Grid.Column="0" Margin="0,0,4,0" Content="啟動" Command="{Binding LaunchCommand}"/>
                      <Button Grid.Column="1" Margin="4,0,0,0" Content="設置" Style="{StaticResource GhostButton}" Command="{Binding SettingsCommand}"/>
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="還沒有快捷啟動卡片&#10;到「實例設置」按「＋ 新增帳號卡片」" TextAlignment="Center" TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Cards.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button Content="＋ 新增卡片" Style="{StaticResource GhostButton}" Command="{Binding OpenSettingsCommand}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip="到實例設置新增帳號卡片"/>
        </Grid>
      </Border>

      <!-- ============ 右欄：設置／下載／P2P／更多／音樂 ============ -->
      <Border Grid.Column="2" Padding="10" CornerRadius="10">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <Button Height="64" Style="{StaticResource NavButton}"
                    local:ArtProps.File="btn_settings.png" Click="SettingsStage_Click">
              <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <Viewbox Width="24" Height="24" Margin="0,0,0,4"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="M14.6,12 A2.6,2.6 0 1 1 9.4,12 A2.6,2.6 0 1 1 14.6,12 Z M18.2,12 A6.2,6.2 0 1 1 5.8,12 A6.2,6.2 0 1 1 18.2,12 Z M20.4,12 L22.9,12 M17.94,17.94 L19.71,19.71 M12,20.4 L12,22.9 M6.06,17.94 L4.29,19.71 M3.6,12 L1.1,12 M6.06,6.06 L4.29,4.29 M12,3.6 L12,1.1 M17.94,6.06 L19.71,4.29"/></Canvas></Viewbox>
                <TextBlock Text="設置" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button Height="64" Style="{StaticResource NavButton}"
                    local:ArtProps.File="btn_download.png" Click="DownloadStage_Click">
              <Button.Content>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                  <Viewbox Width="24" Height="24" Margin="0,0,0,4"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="M12,3 L12,15.5 M6.5,10.5 L12,16 L17.5,10.5 M4.5,20.5 L19.5,20.5"/></Canvas></Viewbox>
                  <TextBlock Text="下載" HorizontalAlignment="Center"/>
                </StackPanel>
              </Button.Content>
            </Button>

            <Button Height="64" Style="{StaticResource NavButton}"
                    local:ArtProps.File="btn_p2p.png" Click="P2PStage_Click">
              <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <Viewbox Width="24" Height="24" Margin="0,0,0,4"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="M9,3 H15 V8 H9 Z M12,8 V13 M5,13 H19M5,13 V16 M19,13 V16 M2.5,16 H7.5 V21 H2.5 Z M16.5,16 H21.5 V21 H16.5 Z"/></Canvas></Viewbox>
                <TextBlock Text="P2P" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button Height="64" Style="{StaticResource NavButton}"
                    local:ArtProps.File="btn_more.png" Click="MoreStage_Click">
              <Button.Content>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                  <Viewbox Width="24" Height="24" Margin="0,0,0,4"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="M3.5,3.5 H10 V10 H3.5 Z M14,3.5 H20.5 V10 H14 Z M3.5,14 H10 V20.5 H3.5 Z"/></Canvas></Viewbox>
                  <TextBlock Text="更多" HorizontalAlignment="Center"/>
                </StackPanel>
              </Button.Content>
            </Button>
          </StackPanel>

          <Button Grid.Row="1" x:Name="MusicBtn" Height="44" Content="♪ 音樂" Style="{StaticResource NavButton}"
                  local:ArtProps.File="btn_music.png" Click="MusicStage_Click"/>
        </Grid>
      </Border>

      <!-- ============ 功能切換覆層（中欄上方） ============ -->
      <Border Grid.Column="1" x:Name="StageOverlay" Panel.ZIndex="50" Margin="14" CornerRadius="8"
              Background="#F01C1C1C" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="16"
              Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Left" Content="← 返回" Style="{StaticResource GhostButton}" Width="90" Click="StageBack_Click"/>
            <TextBlock x:Name="StageTitle" Margin="12,0,0,0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
          </DockPanel>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="StageActions" Orientation="Horizontal" ItemWidth="220" ItemHeight="72"/>
          </ScrollViewer>
          <TextBlock Grid.Row="2" x:Name="StageFooter" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
