<Window x:Class="IEML.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IEML.App"
        Title="Innovation Easy Minecraft Launcher · Beta" Width="980" Height="640" MinWidth="784" MinHeight="512"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource TextBrush}">
  <Grid>
    <!-- 背景圖：Assets\background.png（撐滿並裁掉多出的邊） -->
    <Image Stretch="UniformToFill" Source="{Binding Converter={StaticResource Asset}, ConverterParameter=background.png}"/>

    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="311*" MinWidth="240"/>
        <ColumnDefinition Width="551*"/>
        <ColumnDefinition Width="117*" MinWidth="96"/>
      </Grid.ColumnDefinitions>

      <!-- ============ 左欄：標誌／頭像／狀態／啟動 ============ -->
      <Border Grid.Column="0" Margin="0,0,8,0" Padding="14" CornerRadius="8"
              Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Height="44">
            <Image x:Name="Logo" HorizontalAlignment="Left" Stretch="Uniform"/>
            <TextBlock x:Name="LogoText" Text="IEML" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
          </Grid>

          <!-- 頭像：點了開帳號管理；正版帳號會從 mc-heads.net 抓皮膚頭像，離線／沒網路用 avatar_default.png -->
          <Button Grid.Row="1" Width="132" Height="124" HorizontalAlignment="Left" Margin="0,10,0,0"
                  Style="{StaticResource CardButton}" local:ArtProps.File="avatar_frame.png"
                  Command="{Binding OpenAccountsCommand}" ToolTip="帳號管理">
            <Grid Margin="10">
              <Image Stretch="Uniform" Source="{Binding Converter={StaticResource Asset}, ConverterParameter=avatar_default.png}"/>
              <Image Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding AvatarUrl}"/>
            </Grid>
          </Button>

          <StackPanel Grid.Row="2" Margin="0,12,0,8">
            <TextBlock Text="{Binding SelectedInstance.Name}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding SelectedInstance.McVersion}" Foreground="{StaticResource MutedBrush}"/>
              <TextBlock Text="  ·  " Foreground="{StaticResource MutedBrush}"/>
              <TextBlock Text="{Binding SelectedInstance.Loader}" Foreground="{StaticResource MutedBrush}"/>
            </StackPanel>
            <ComboBox ItemsSource="{Binding Accounts}" DisplayMemberPath="DisplayName"
                      SelectedItem="{Binding SelectedAccount}" Margin="0,8,0,0"/>
            <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="8" Margin="0,10,0,0">
              <ProgressBar.Style>
                <Style TargetType="ProgressBar">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </ProgressBar.Style>
            </ProgressBar>
            <TextBlock Text="{Binding Status}" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
          </StackPanel>

          <Button Grid.Row="3" Height="83" Margin="0,0,0,8" Content="啟動" FontSize="26" FontWeight="Bold"
                  Style="{StaticResource ArtButton}" local:ArtProps.File="btn_launch.png"
                  Command="{Binding LaunchCommand}"/>

          <Grid Grid.Row="4" Height="80">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="0,0,4,0" Content="實例設置" Style="{StaticResource ArtButton}"
                    local:ArtProps.File="btn_instance_settings.png" Command="{Binding OpenSettingsCommand}"/>
            <Button Grid.Column="1" Margin="4,0,0,0" Content="實例選擇" Style="{StaticResource ArtButton}"
                    local:ArtProps.File="btn_instance_pick.png" Command="{Binding OpenInstancePickerCommand}"/>
          </Grid>
        </Grid>
      </Border>

      <!-- ============ 中欄：快捷啟動卡片（數量不限，超過會捲動） ============ -->
      <Border Grid.Column="1" Margin="0,0,8,0" Padding="14" CornerRadius="8"
              Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
          <!-- 畫布：卡片可以拖到任何位置（位置會存起來）；點一下啟動，拖拉超過一小段距離才算移動 -->
          <ItemsControl x:Name="CardsHost" ItemsSource="{Binding Cards}" ClipToBounds="True" SizeChanged="CardsHost_SizeChanged">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Width="208" Height="260" ToolTip="拖拉移動位置，點一下啟動"
                        Style="{StaticResource CardButton}" local:ArtProps.File="card.png"
                        PreviewMouseLeftButtonDown="Card_Down" PreviewMouseMove="Card_Move" PreviewMouseLeftButtonUp="Card_Up">
                  <StackPanel VerticalAlignment="Bottom" Margin="12">
                    <TextBlock Text="{Binding InstanceName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding AccountName}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Text="還沒有快捷啟動卡片&#10;到「實例設置」按「＋ 新增帳號卡片」" TextAlignment="Center" TextWrapping="Wrap"
                     HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Cards.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Grid>
      </Border>

      <!-- ============ 右欄：設置／下載／P2P／更多／音樂 ============ -->
      <Border Grid.Column="2" Padding="10" CornerRadius="8"
              Background="{StaticResource PanelBg}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <Button Height="44" Margin="0,0,0,8" Content="設置" Style="{StaticResource ArtButton}"
                    local:ArtProps.File="btn_settings.png" Command="{Binding OpenLauncherSettingsCommand}"/>

            <Button Height="44" Margin="0,0,0,8" Content="下載" Style="{StaticResource ArtButton}"
                    local:ArtProps.File="btn_download.png" Click="OpenMenu_Click">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="Modrinth（模組／光影／資源包／整合包）" Command="{Binding OpenContentCommand}"/>
                  <MenuItem Header="CurseForge（含本機匯入整合包）" Command="{Binding OpenCurseForgeCommand}"/>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>

            <Button Height="44" Margin="0,0,0,8" Content="P2P" Style="{StaticResource ArtButton}"
                    local:ArtProps.File="btn_p2p.png" Command="{Binding OpenTerracottaCommand}"/>

            <Button Height="44" Margin="0,0,0,8" Content="更多" Style="{StaticResource ArtButton}"
                    local:ArtProps.File="btn_more.png" Click="OpenMenu_Click">
              <Button.ContextMenu>
                <ContextMenu>
                  <MenuItem Header="伺服器查找" Command="{Binding OpenServersCommand}"/>
                  <MenuItem Header="遊戲日誌" Command="{Binding OpenLogCommand}"/>
                  <MenuItem Header="EasyTier 房間（進階）" Command="{Binding OpenRoomCommand}"/>
                  <MenuItem Header="種子地圖" Command="{Binding OpenSeedMapCommand}"/>
                  <MenuItem Header="帳號管理" Command="{Binding OpenAccountsCommand}"/>
                </ContextMenu>
              </Button.ContextMenu>
            </Button>
          </StackPanel>

          <Button Grid.Row="1" x:Name="MusicBtn" Height="44" Content="音樂" Style="{StaticResource ArtButton}"
                  local:ArtProps.File="btn_music.png" Click="Music_Click"/>

          <Popup x:Name="MusicPopup" PlacementTarget="{Binding ElementName=MusicBtn}" Placement="Left"
                 StaysOpen="False" AllowsTransparency="True">
            <Border Width="270" Padding="12" CornerRadius="8" Background="#F0141820"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    TextElement.Foreground="{StaticResource TextBrush}">
              <StackPanel>
                <TextBlock Text="{Binding MusicTitle}" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,8">
                  <Button Content="⏮" Command="{Binding PrevMusicCommand}" Width="36" Height="30"/>
                  <Button Content="▶" Command="{Binding PlayMusicCommand}" Width="36" Height="30" Margin="4,0"/>
                  <Button Content="⏸" Command="{Binding PauseMusicCommand}" Width="36" Height="30"/>
                  <Button Content="⏭" Command="{Binding NextMusicCommand}" Width="36" Height="30" Margin="4,0,0,0"/>
                </StackPanel>
                <Slider Minimum="0" Maximum="1" Value="{Binding MusicVolume}"/>
                <Button Content="📁 音樂資料夾" Command="{Binding AddMusicFolderCommand}" Padding="8,4" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </Popup>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
