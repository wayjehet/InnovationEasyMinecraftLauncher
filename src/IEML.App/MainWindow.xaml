<Window x:Class="IEML.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:IEML.App"
        Icon="app.ico"
        Title="Innovation Easy Minecraft Launcher" Width="980" Height="640" MinWidth="784" MinHeight="512"
        Background="{DynamicResource WindowBg}" Foreground="{DynamicResource TextBrush}">
  <Grid>
    <!-- 程式繪製的簡潔背景（同網頁橫幅的深綠漸層）；Assets\background.png 存在時會蓋過它 -->
    <local:SkinBorder Slot="background" Fit="Cover" IsHitTestVisible="False">
      <local:SkinBorder.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#FF0F1F1A" Offset="0"/>
          <GradientStop Color="#FF12302A" Offset="0.5"/>
          <GradientStop Color="#FF0F0F0F" Offset="1"/>
        </LinearGradientBrush>
      </local:SkinBorder.Background>
    </local:SkinBorder>

    <Grid Margin="12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="311*" MinWidth="240"/>
        <ColumnDefinition Width="551*"/>
        <ColumnDefinition Width="117*" MinWidth="96"/>
      </Grid.ColumnDefinitions>

      <!-- 單一外框＋兩條分隔線（照草圖） -->
      <local:SkinBorder Slot="panel_main" Grid.ColumnSpan="3" CornerRadius="10" Background="{DynamicResource PanelBg}"
              BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"/>
      <Rectangle Grid.Column="0" Width="1" HorizontalAlignment="Right" Margin="0,1" Fill="{DynamicResource LineBrush}"/>
      <Rectangle Grid.Column="1" Width="1" HorizontalAlignment="Right" Margin="0,1" Fill="{DynamicResource LineBrush}"/>

      <!-- ============ 左欄：標誌／頭像／帳號／狀態／啟動 ============ -->
      <Border Grid.Column="0" Margin="0" Padding="14" CornerRadius="10">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- 標誌：有 logo.png 就顯示圖；沒有就顯示文字（E 是青色） -->
          <Grid Grid.Row="0" Height="44">
            <Image x:Name="Logo" HorizontalAlignment="Left" Stretch="Uniform"/>
            <StackPanel x:Name="LogoText" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock FontSize="28" FontWeight="Bold"><Run Text="I"/><Run Text="E" Foreground="{DynamicResource AccentBrush}"/><Run Text="ML"/></TextBlock>
            </StackPanel>
          </Grid>

          <!-- 頭像（圓形青色外圈）＋目前實例：點頭像開帳號管理；正版帳號顯示皮膚頭像，否則顯示名字首字 -->
          <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Width="64" Height="64" Style="{StaticResource FlatButton}"
                    Command="{Binding OpenAccountsCommand}" ToolTip="帳號管理">
              <Grid>
                <Ellipse Fill="#FF263A36" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"/>
                <TextBlock Text="{Binding AvatarInitial}" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Ellipse Margin="3"><Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarUrl}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                <local:SkinBorder Slot="avatar_frame" IsHitTestVisible="False"/>
              </Grid>
            </Button>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="{Binding SelectedInstance.Name}" FontSize="18" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectedInstance.McVersion}" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Text=" · " Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock Text="{Binding SelectedInstance.Loader}" Foreground="{DynamicResource MutedBrush}"/>
              </StackPanel>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="2" Margin="0,16,0,8">
            <TextBlock Text="使用帳號" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
            <ComboBox Style="{StaticResource DarkComboBox}" ItemsSource="{Binding Accounts}" DisplayMemberPath="DisplayName"
                      SelectedItem="{Binding SelectedAccount}" Margin="0,4,0,0"/>
            <TextBlock Text="{Binding Status}" Margin="0,16,0,6" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap"/>
            <ProgressBar Style="{StaticResource DarkProgress}" local:SmoothProgress.Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"/>
          </StackPanel>

          <Grid Grid.Row="3" Height="56" Margin="0,0,0,8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Content="啟動" FontSize="22" FontWeight="Bold"
                    Style="{StaticResource ArtButton}" local:ArtProps.File="btn_launch"
                    Command="{Binding LaunchCommand}"/>
            <Button Grid.Column="1" Content="▾" Width="40" Margin="6,0,0,0" FontSize="16" Style="{StaticResource GhostButton}"
                    Click="ServerMenu_Click" ToolTip="選一個伺服器，啟動後直接加入"/>
          </Grid>

          <Grid Grid.Row="4" Height="40">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Button Grid.Column="0" Margin="0,0,4,0" Content="實例設置" Style="{StaticResource GhostButton}" local:ArtProps.File="btn_instance_settings"
                    Command="{Binding OpenSettingsCommand}"/>
            <Button Grid.Column="1" Margin="4,0,0,0" Content="實例選擇" Style="{StaticResource GhostButton}" local:ArtProps.File="btn_instance_pick"
                    Command="{Binding OpenInstancePickerCommand}"/>
          </Grid>
        </Grid>
      </Border>

      <!-- ============ 中欄：快捷啟動卡片（數量不限，超過會捲動） ============ -->
      <Border Grid.Column="1" Margin="0" Padding="14" CornerRadius="10">
        <Grid>
          <!-- 畫布：卡片可以拖到任何位置（位置會存起來）；點一下啟動，拖拉超過一小段距離才算移動 -->
          <ItemsControl x:Name="CardsHost" ItemsSource="{Binding Cards}" ClipToBounds="True" SizeChanged="CardsHost_SizeChanged">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><Canvas/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerStyle>
              <Style TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding X}"/>
                <Setter Property="Canvas.Top" Value="{Binding Y}"/>
                <Setter Property="Panel.ZIndex" Value="{Binding Z}"/>
              </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <!-- 小卡片：上面是頭像＋名稱（拖這一塊可移動），下面是「啟動」「設置」兩顆按鈕 -->
                <local:SkinBorder Slot="card" Width="210" Height="104" CornerRadius="8" Background="{DynamicResource PanelBg}"
                        BorderThickness="1" Loaded="Card_Loaded">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                      <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid Margin="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="Transparent" Cursor="SizeAll" ToolTip="拖拉移動位置"
                            PreviewMouseLeftButtonDown="Card_Down" PreviewMouseMove="Card_Move" PreviewMouseLeftButtonUp="Card_Up">
                      <DockPanel>
                        <Grid DockPanel.Dock="Left" Width="34" Height="34" Margin="0,0,10,0">
                          <Ellipse Fill="#FF263A36"/>
                          <TextBlock Text="{Binding Initial}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding InstanceName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding AccountName}" FontSize="12" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </DockPanel>
                    </Border>
                    <Grid Grid.Row="1" VerticalAlignment="Bottom" Height="30">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                      <Button Grid.Column="0" Margin="0,0,4,0" Content="啟動" Command="{Binding LaunchCommand}"/>
                      <Button Grid.Column="1" Margin="4,0,0,0" Content="設置" Style="{StaticResource GhostButton}" Command="{Binding SettingsCommand}"/>
                    </Grid>
                  </Grid>
                </local:SkinBorder>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <!-- 空狀態：沒有卡片時顯示說明＋新增按鈕（會浮動，見 Motion.Float） -->
          <StackPanel x:Name="EmptyHint" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
              <Style TargetType="StackPanel">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Cards.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </StackPanel.Style>
            <TextBlock Text="還沒有快捷啟動卡片&#10;卡片可以一鍵用指定帳號啟動這個實例" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource MutedBrush}"/>
            <Button Content="＋ 新增卡片" Style="{StaticResource GhostButton}" Command="{Binding AddCardCommand}"
                    Width="140" Height="36" Margin="0,14,0,0" HorizontalAlignment="Center"/>
          </StackPanel>
          <Button Content="＋ 新增卡片" Style="{StaticResource GhostButton}" Command="{Binding AddCardCommand}"
                  HorizontalAlignment="Right" VerticalAlignment="Bottom" ToolTip="用目前選的帳號新增一張快捷卡片（要換帳號到實例設置 → 快捷卡片）"/>
        </Grid>
      </Border>

      <!-- ============ 右欄：設置／下載／P2P／更多／音樂 ============ -->
      <Border Grid.Column="2" Padding="10" CornerRadius="10">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

          <StackPanel Grid.Row="0">
            <Button Height="64" Style="{StaticResource NavButton}"
                    local:ArtProps.File="btn_settings" Click="SettingsStage_Click">
              <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <Viewbox Width="24" Height="24" Margin="0,0,0,4"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="M14.6,12 A2.6,2.6 0 1 1 9.4,12 A2.6,2.6 0 1 1 14.6,12 Z M18.2,12 A6.2,6.2 0 1 1 5.8,12 A6.2,6.2 0 1 1 18.2,12 Z M20.4,12 L22.9,12 M17.94,17.94 L19.71,19.71 M12,20.4 L12,22.9 M6.06,17.94 L4.29,19.71 M3.6,12 L1.1,12 M6.06,6.06 L4.29,4.29 M12,3.6 L12,1.1 M17.94,6.06 L19.71,4.29"/></Canvas></Viewbox>
                <TextBlock Text="設置" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button Height="64" Style="{StaticResource NavButton}"
                    local:ArtProps.File="btn_download" Click="DownloadStage_Click">
              <Button.Content>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                  <Viewbox Width="24" Height="24" Margin="0,0,0,4"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="M12,3 L12,15.5 M6.5,10.5 L12,16 L17.5,10.5 M4.5,20.5 L19.5,20.5"/></Canvas></Viewbox>
                  <TextBlock Text="下載" HorizontalAlignment="Center"/>
                </StackPanel>
              </Button.Content>
            </Button>

            <Button Height="64" Style="{StaticResource NavButton}"
                    local:ArtProps.File="btn_p2p" Click="P2PStage_Click">
              <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                <Viewbox Width="24" Height="24" Margin="0,0,0,4"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="M9,3 H15 V8 H9 Z M12,8 V13 M5,13 H19M5,13 V16 M19,13 V16 M2.5,16 H7.5 V21 H2.5 Z M16.5,16 H21.5 V21 H16.5 Z"/></Canvas></Viewbox>
                <TextBlock Text="P2P" HorizontalAlignment="Center"/>
              </StackPanel>
            </Button>

            <Button Height="64" Style="{StaticResource NavButton}"
                    local:ArtProps.File="btn_more" Click="MoreStage_Click">
              <Button.Content>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                  <Viewbox Width="24" Height="24" Margin="0,0,0,4"><Canvas Width="24" Height="24"><Path Style="{StaticResource NavIcon}" Data="M3.5,3.5 H10 V10 H3.5 Z M14,3.5 H20.5 V10 H14 Z M3.5,14 H10 V20.5 H3.5 Z"/></Canvas></Viewbox>
                  <TextBlock Text="更多" HorizontalAlignment="Center"/>
                </StackPanel>
              </Button.Content>
            </Button>
          </StackPanel>

          <Button Grid.Row="1" x:Name="MusicBtn" Height="44" Content="♪ 音樂" Style="{StaticResource NavButton}"
                  local:ArtProps.File="btn_music" Click="MusicStage_Click"/>
        </Grid>
      </Border>

      <!-- 視窗內對話框層：新增實例、選實例、選 Java 等小對話框（蓋在所有頁面與提示條上；Esc 取消） -->
      <Grid x:Name="ModalLayer" Grid.ColumnSpan="3" Panel.ZIndex="200" Visibility="Collapsed">
        <Rectangle Fill="#B3000000"/>
        <local:SkinBorder Slot="modal" x:Name="ModalBox" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="640" Padding="18" CornerRadius="10"
                Background="#FF1C1C1C" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
          <DockPanel>
            <TextBlock x:Name="ModalTitle" DockPanel.Dock="Top" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
            <ContentControl x:Name="ModalBody"/>
          </DockPanel>
        </local:SkinBorder>
      </Grid>

      <!-- 提示條（啟動成功、錯誤等；蓋在最上層，頁面開著也看得到） -->
      <Border x:Name="ToastHost" Grid.ColumnSpan="3" Panel.ZIndex="100" Visibility="Collapsed" IsHitTestVisible="False"
              HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24" Padding="16,9" CornerRadius="8"
              Background="#F2141414" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" MaxWidth="560">
        <TextBlock x:Name="ToastText" TextWrapping="Wrap" Foreground="{DynamicResource TextBrush}"/>
      </Border>

      <!-- ============ 功能切換覆層（蓋住左＋中欄，右欄保留） ============ -->
      <Border Grid.Column="0" Grid.ColumnSpan="2" x:Name="StageOverlay" Panel.ZIndex="50" Margin="14" CornerRadius="8"
              Background="#F01C1C1C" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Padding="16"
              Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Left" Content="← 返回" Style="{StaticResource GhostButton}" Width="90" Click="StageBack_Click"/>
            <TextBlock x:Name="StageTitle" Margin="12,0,0,0" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
          </DockPanel>
          <ScrollViewer x:Name="StageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <WrapPanel x:Name="StageActions" Orientation="Horizontal" ItemWidth="220" ItemHeight="72"/>
          </ScrollViewer>
          <!-- 需要固定高度的頁面（實例設置、更多）放這裡，不放進會捲動的 WrapPanel -->
          <ContentControl x:Name="StageHost" Grid.Row="1" Visibility="Collapsed" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
          <TextBlock Grid.Row="2" x:Name="StageFooter" Foreground="{DynamicResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
          <!-- 頁面蓋住左欄時看不到啟動進度條：忙碌中（啟動／下載更新）才在頁面底部顯示一條細狀態列 -->
          <Border Grid.Row="3" x:Name="StageStatusBar" Margin="0,10,0,0" Padding="0,8,0,0"
                  BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <DockPanel>
              <TextBlock DockPanel.Dock="Left" Text="{Binding Status}" MaxWidth="360" Margin="0,0,12,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
              <ProgressBar Style="{StaticResource DarkProgress}" VerticalAlignment="Center" local:SmoothProgress.Value="{Binding ProgressPercent}" Minimum="0" Maximum="100"/>
            </DockPanel>
          </Border>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
