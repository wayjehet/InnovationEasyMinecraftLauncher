<Window x:Class="IEML.App.InstancePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="選擇實例" Width="420" Height="460" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
      <Button Content="新增實例" Command="{Binding AddInstanceCommand}" Padding="10,5" Margin="0,0,6,0"/>
      <Button Content="刪除實例" Command="{Binding DeleteInstanceCommand}" Padding="10,5" Margin="0,0,6,0"/>
      <Button Content="選擇" Click="Ok_Click" Width="80" Padding="0,5" IsDefault="True"/>
    </StackPanel>
    <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" MouseDoubleClick="List_DoubleClick">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <StackPanel Margin="2,4">
            <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{Binding McVersion}" Foreground="Gray"/>
              <TextBlock Text="  ·  " Foreground="Gray"/>
              <TextBlock Text="{Binding Loader}" Foreground="Gray"/>
            </StackPanel>
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
