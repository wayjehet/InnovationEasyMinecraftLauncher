<UserControl x:Class="IEML.App.DownloadStageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:IEML.App">
  <UserControl.Resources>
    <!-- 只作用在下載頁：深色輸入框／勾選框（其他視窗還是預設淺色，不受影響） -->
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#FF131313"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
      <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>
  </UserControl.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Padding="0,0,0,10">
      <StackPanel>
        <TextBlock Text="下載中心" FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
        <WrapPanel>
          <Button x:Name="GameTab" Content="遊戲" Width="74" Height="32" Margin="0,0,6,6" Click="Tab_Click" Tag="game"/>
          <Button x:Name="ContentTab" Content="內容" Width="74" Height="32" Margin="0,0,6,6" Click="Tab_Click" Tag="content"/>
          <Button Content="匯入整合包" Height="32" Padding="12,0" Margin="0,0,6,6" Click="ImportLocal_Click" ToolTip="匯入本機 .mrpack／.zip 整合包（已安裝的模組、光影、資源包請到「實例設置」管理）"/>
          <Button x:Name="MapsTab" Content="地圖" Width="74" Height="32" Margin="0,0,6,6" Click="Maps_Click" ToolTip="匯入／下載地圖到上面「安裝到實例」選的實例"/>
        </WrapPanel>
      </StackPanel>
    </Border>

    <Grid x:Name="GamePanel">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,14,0">
        <TextBlock Text="實例名稱" Foreground="Gray" FontSize="12"/>
        <TextBox x:Name="NameBox" Height="32" Margin="0,4,0,10"/>
        <TextBlock Text="Minecraft 版本" Foreground="Gray" FontSize="12"/>
        <ComboBox x:Name="VersionBox" Height="32" IsEditable="True" Margin="0,4,0,10"/>
        <TextBlock Text="載入器" Foreground="Gray" FontSize="12"/>
        <ComboBox Style="{StaticResource DarkComboBox}" x:Name="LoaderBox" Height="32" Margin="0,4,0,10"/>
        <TextBlock Text="載入器版本" Foreground="Gray" FontSize="12"/>
        <ComboBox x:Name="LoaderVersionBox" Height="32" Margin="0,4,0,10" IsEditable="True"/>
        <TextBlock Text="安裝到實例" Foreground="Gray" FontSize="12"/>
        <ComboBox Style="{StaticResource DarkComboBox}" x:Name="InstanceBox" Height="32" DisplayMemberPath="Name" Margin="0,4,0,10"/>
        <CheckBox x:Name="IncludeSnapshots" Content="顯示快照與舊版" Margin="0,0,0,10" Checked="VersionsChanged" Unchecked="VersionsChanged"/>
        <Border Background="#FF141414" BorderBrush="#FF333333" BorderThickness="1" CornerRadius="6" Padding="12">
          <StackPanel>
            <TextBlock Text="安裝摘要" FontWeight="Bold" Margin="0,0,0,6"/>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" Foreground="#FFCCCCCC"/>
          </StackPanel>
        </Border>
      </StackPanel>
      <Border Grid.Column="1" Background="#FF141414" BorderBrush="#FF333333" BorderThickness="1" CornerRadius="8" Padding="12" VerticalAlignment="Top">
        <StackPanel>
          <TextBlock Text="準備建立實例" FontWeight="Bold" Margin="0,0,0,10"/>
          <ProgressBar x:Name="InstallProgress" Height="8" Minimum="0" Maximum="100" Margin="0,0,0,8"/>
          <Button x:Name="CreateButton" Content="建立實例" Height="38" FontWeight="Bold" Click="Create_Click"/>
          <TextBlock x:Name="GameStatus" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#FF888888"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="ContentPanel" Visibility="Collapsed">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <DockPanel Grid.Row="0">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
          <ComboBox Style="{StaticResource DarkComboBox}" x:Name="SourceBox" Width="100" Height="32" Margin="0,0,6,6" SelectedIndex="0" SelectionChanged="FiltersChanged">
            <ComboBoxItem Content="Modrinth" Tag="Modrinth"/><ComboBoxItem Content="CurseForge" Tag="CurseForge"/>
          </ComboBox>
          <ComboBox Style="{StaticResource DarkComboBox}" x:Name="SortBox" Width="100" Height="32" Margin="0,0,6,6" SelectedIndex="0" SelectionChanged="FiltersChanged">
            <ComboBoxItem Content="相關度" Tag="relevance"/><ComboBoxItem Content="下載數" Tag="downloads"/><ComboBoxItem Content="最新發布" Tag="newest"/><ComboBoxItem Content="最近更新" Tag="updated"/>
          </ComboBox>
          <ComboBox Style="{StaticResource DarkComboBox}" x:Name="CategoryBox" Width="120" Height="32" Margin="0,0,6,6" SelectionChanged="FiltersChanged"/>
          <ComboBox Style="{StaticResource DarkComboBox}" x:Name="LoaderFilterBox" Width="100" Height="32" Margin="0,0,6,6" SelectionChanged="FiltersChanged"/>
          <ComboBox Style="{StaticResource DarkComboBox}" x:Name="EnvBox" Width="100" Height="32" Margin="0,0,6,6" SelectedIndex="0" SelectionChanged="FiltersChanged">
            <ComboBoxItem Content="全部端" Tag=""/><ComboBoxItem Content="客戶端" Tag="client"/><ComboBoxItem Content="伺服器" Tag="server"/>
          </ComboBox>
          <ComboBox x:Name="FilterMcBox" Width="120" Height="32" Margin="0,0,6,6" IsEditable="True" SelectionChanged="FiltersChanged"/>
          <TextBlock Text="安裝到" Foreground="#FF888888" VerticalAlignment="Center" Margin="6,0,6,6"/>
          <ComboBox Style="{StaticResource DarkComboBox}" x:Name="TargetBox" Width="150" Height="32" Margin="0,0,6,6" SelectionChanged="TargetChanged"/>
        </WrapPanel>
        <Button DockPanel.Dock="Right" Content="搜尋" Width="72" Height="32" Margin="8,0,0,0" Click="Search_Click"/>
        <ComboBox Style="{StaticResource DarkComboBox}" DockPanel.Dock="Right" x:Name="KindBox" Width="100" Height="32" Margin="8,0,0,0" SelectedIndex="0" SelectionChanged="KindChanged">
          <ComboBoxItem Content="模組" Tag="Mod"/><ComboBoxItem Content="光影" Tag="Shader"/><ComboBoxItem Content="資源包" Tag="ResourcePack"/><ComboBoxItem Content="整合包" Tag="Modpack"/>
        </ComboBox>
        <TextBox x:Name="QueryBox" Height="32"/>
      </DockPanel>
      <ListBox x:Name="ResultsList" Grid.Row="1" Margin="0,10,0,8" HorizontalContentAlignment="Stretch"
               Background="#FF131313" BorderBrush="{StaticResource LineBrush}" Foreground="{StaticResource TextBrush}"
               SelectionChanged="ResultsList_SelectionChanged">
        <ListBox.ItemTemplate>
          <DataTemplate>
            <DockPanel Margin="4">
              <Button DockPanel.Dock="Right" Content="安裝" Padding="12,4" Margin="8,0,0,0" VerticalAlignment="Center" Tag="{Binding}" Click="InstallHit_Click"/>
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Description}" Foreground="#FF888888" TextWrapping="Wrap" MaxHeight="36"/>
                <TextBlock Text="{Binding DownloadsText}" Foreground="#FF00AAAA" FontSize="11"/>
              </StackPanel>
            </DockPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <TextBlock x:Name="ContentStatus" Grid.Row="2" Foreground="#FF888888" TextWrapping="Wrap"/>
      <local:ProjectDetailView x:Name="Detail" Grid.RowSpan="3" Visibility="Collapsed"/>
    </Grid>

  </DockPanel>
</UserControl>
