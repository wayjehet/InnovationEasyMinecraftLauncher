<UserControl x:Class="IEML.App.JavaPickerPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PageStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </UserControl.Resources>
  <DockPanel Height="320">
    <TextBlock x:Name="InfoText" DockPanel.Dock="Top" TextWrapping="Wrap" Text="偵測中…"/>
    <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,8"
               Text="自動順序：本機符合版本 → 本機較高版本 → 已下載／自動下載符合版本。這裡可手動改指定某一個。"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button Content="重新偵測" Click="Refresh_Click" Padding="12,5" Margin="0,0,8,0"/>
      <Button Content="自動（清除指定）" Click="Auto_Click" Padding="12,5" Margin="0,0,8,0"/>
      <Button Content="使用選取的" Click="Pick_Click" Padding="12,5" Margin="0,0,8,0"/>
      <Button Content="取消" Click="Cancel_Click" Padding="12,5" Style="{StaticResource GhostButton}"/>
    </StackPanel>
    <ListBox x:Name="List" DisplayMemberPath="Description" MouseDoubleClick="List_DoubleClick"/>
  </DockPanel>
</UserControl>
