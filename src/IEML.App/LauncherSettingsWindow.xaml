<Window x:Class="IEML.App.LauncherSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="啟動器設定" Width="500" Height="640" WindowStartupLocation="CenterOwner">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
      <TextBlock Text="帳號" FontWeight="Bold" FontSize="15"/>
      <Button Content="開啟帳號管理…" Command="{Binding OpenAccountsCommand}" HorizontalAlignment="Left" Padding="12,5" Margin="0,6,0,18"/>

      <TextBlock Text="CurseForge API 金鑰" FontWeight="Bold" FontSize="15"/>
      <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,4"
                 Text="自己到 console.curseforge.com 申請；只存在你的電腦，以 Windows 帳號加密。匯入 Modrinth .mrpack 不需要。"/>
      <DockPanel Margin="0,0,0,2">
        <Button DockPanel.Dock="Right" Content="儲存" Click="SaveKey_Click" Padding="12,4" Margin="8,0,0,0"/>
        <PasswordBox x:Name="KeyBox"/>
      </DockPanel>
      <TextBlock x:Name="KeyStatus" Foreground="Gray" Margin="0,0,0,18"/>

      <TextBlock Text="外觀與素材" FontWeight="Bold" FontSize="15"/>
      <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,2,0,6"
                 Text="把畫好的 PNG 放進素材資料夾，檔名要完全一致，換圖後重新開啟啟動器生效。沒放的圖會用預設樣式。"/>
      <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
        <Button Content="開啟素材資料夾" Click="OpenAssets_Click" Padding="12,5"/>
        <Button Content="重設快捷卡片位置" Command="{Binding ResetCardLayoutCommand}" Padding="12,5" Margin="8,0,0,0"/>
      </StackPanel>
      <TextBox x:Name="AssetList" IsReadOnly="True" TextWrapping="Wrap" Margin="0,0,0,18" BorderThickness="0" Background="Transparent"/>

      <TextBlock Text="關於" FontWeight="Bold" FontSize="15"/>
      <TextBlock x:Name="VersionText" Margin="0,4,0,0"/>
      <TextBlock Foreground="Orange" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="Beta 測試版：功能還在開發中，可能有錯誤。遇到問題請附上「遊戲日誌」回報。"/>
      <Button Content="開啟 GitHub 專案頁" Click="OpenRepo_Click" HorizontalAlignment="Left" Padding="12,5" Margin="0,8,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button Content="檢查更新" Command="{Binding CheckUpdateCommand}" Padding="12,5"/>
        <CheckBox x:Name="AutoUpdateBox" Content="啟動時自動檢查更新" Margin="12,0,0,0" VerticalAlignment="Center" Click="AutoUpdate_Click"/>
      </StackPanel>
      <TextBlock Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0"
                 Text="本專案與 Mojang Studios、Microsoft 無關，亦非其官方產品。"/>
    </StackPanel>
  </ScrollViewer>
</Window>
