<UserControl x:Class="IEML.App.LauncherSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextBrush}">
  <UserControl.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="PageStyles.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </UserControl.Resources>
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16">
      <TextBlock Text="帳號" FontWeight="Bold" FontSize="15"/>
      <Button Content="開啟帳號管理…" Command="{Binding OpenAccountsCommand}" HorizontalAlignment="Left" Padding="12,5" Margin="0,6,0,18"/>

      <TextBlock Text="CurseForge API 金鑰" FontWeight="Bold" FontSize="15"/>
      <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,4"
                 Text="自己到 console.curseforge.com 申請；只存在你的電腦，以 Windows 帳號加密。匯入 Modrinth .mrpack 不需要。"/>
      <DockPanel Margin="0,0,0,2">
        <Button DockPanel.Dock="Right" Content="儲存" Click="SaveKey_Click" Padding="12,4" Margin="8,0,0,0"/>
        <PasswordBox x:Name="KeyBox"/>
      </DockPanel>
      <TextBlock x:Name="KeyStatus" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,18"/>

      <TextBlock Text="實例目錄" FontWeight="Bold" FontSize="15"/>
      <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,4"
                 Text="實例目錄的新增、移除、切換與開啟，已移到「實例選擇」裡（上方的「目錄」下拉選單）。"/>
      <Button Content="開啟實例選擇…" Command="{Binding OpenInstancePickerCommand}" HorizontalAlignment="Left" Padding="12,5" Margin="0,6,0,18"/>

      <TextBlock Text="外觀與素材" FontWeight="Bold" FontSize="15"/>
      <Button Content="重設快捷卡片位置" Command="{Binding ResetCardLayoutCommand}" HorizontalAlignment="Left" Padding="12,5" Margin="0,6,0,10"/>
      <ContentControl x:Name="SkinHost" Margin="0,0,0,18"/>

      <TextBlock Text="關於" FontWeight="Bold" FontSize="15"/>
      <TextBlock x:Name="VersionText" Margin="0,4,0,0"/>
      <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                 Text="遇到問題請附上「遊戲日誌」回報。"/>
      <Button Content="開啟 GitHub 專案頁" Click="OpenRepo_Click" HorizontalAlignment="Left" Padding="12,5" Margin="0,8,0,0"/>
      <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
        <Button Content="檢查更新" Command="{Binding CheckUpdateCommand}" Padding="12,5"/>
        <CheckBox x:Name="AutoUpdateBox" Content="啟動時自動檢查更新" Margin="12,0,0,0" VerticalAlignment="Center" Click="AutoUpdate_Click"/>
      </StackPanel>
      <TextBlock Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                 Text="本專案與 Mojang Studios、Microsoft 無關，亦非其官方產品。"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
