<Window x:Class="IEML.App.ContentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模組與內容 (Modrinth)" Width="820" Height="700" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <TextBlock x:Name="Info" DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,8"/>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <TabControl x:Name="Tabs" SelectionChanged="Tabs_SelectionChanged">

      <!-- ===== 搜尋 ===== -->
      <TabItem Header="搜尋與安裝">
        <DockPanel Margin="0,10,0,0">
          <DockPanel DockPanel.Dock="Top">
            <Button DockPanel.Dock="Right" Content="搜尋" Click="Search_Click" Padding="14,4" Margin="8,0,0,0" IsDefault="True"/>
            <ComboBox DockPanel.Dock="Left" x:Name="KindBox" Width="100" SelectedIndex="0" Margin="0,0,8,0" SelectionChanged="KindBox_Changed">
              <ComboBoxItem Content="模組" Tag="Mod"/>
              <ComboBoxItem Content="光影" Tag="Shader"/>
              <ComboBoxItem Content="資源包" Tag="ResourcePack"/>
              <ComboBoxItem Content="整合包" Tag="Modpack"/>
            </ComboBox>
            <TextBox x:Name="QueryBox"/>
          </DockPanel>

          <!-- 篩選列 -->
          <WrapPanel DockPanel.Dock="Top" Margin="0,8,0,0">
            <StackPanel Margin="0,0,10,4"><TextBlock Text="排序" Foreground="Gray" FontSize="11"/>
              <ComboBox x:Name="SortBox" Width="100" SelectedIndex="0" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
            <StackPanel Margin="0,0,10,4"><TextBlock Text="分類" Foreground="Gray" FontSize="11"/>
              <ComboBox x:Name="CategoryBox" Width="120" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
            <StackPanel x:Name="LoaderPanel" Margin="0,0,10,4"><TextBlock x:Name="LoaderLabel" Text="載入器" Foreground="Gray" FontSize="11"/>
              <ComboBox x:Name="LoaderBox" Width="100" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
            <StackPanel x:Name="EnvPanel" Margin="0,0,10,4"><TextBlock Text="執行端" Foreground="Gray" FontSize="11"/>
              <ComboBox x:Name="EnvBox" Width="100" SelectedIndex="0" DisplayMemberPath="Name" SelectedValuePath="Id"/></StackPanel>
            <StackPanel Margin="0,0,10,4"><TextBlock Text="MC 版本（空白＝全部）" Foreground="Gray" FontSize="11"/>
              <ComboBox x:Name="McBox" Width="150" IsEditable="True"/></StackPanel>
            <Button Content="重設篩選" Click="ResetFilters_Click" Padding="10,2" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
          </WrapPanel>

          <Button DockPanel.Dock="Bottom" x:Name="MoreBtn" Content="載入更多" Click="More_Click" Padding="14,4" Margin="0,8,0,0" Visibility="Collapsed"/>
          <ListBox ItemsSource="{Binding Results}" Margin="0,8,0,0" HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,4">
                  <Button DockPanel.Dock="Right" Content="安裝" Click="Install_Click" Padding="12,4" VerticalAlignment="Center" Margin="8,0,0,0"/>
                  <Image DockPanel.Dock="Left" Source="{Binding IconUrl}" Width="48" Height="48" Margin="0,0,10,0" VerticalAlignment="Top"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Description}" Foreground="Gray" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="{Binding DownloadsText}" Foreground="#FF00AAAA" FontSize="11"/>
                      <TextBlock Text="{Binding AuthorText}" Foreground="Gray" FontSize="11" Margin="10,0,0,0"/>
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <!-- ===== 已安裝 ===== -->
      <TabItem Header="已安裝管理">
        <DockPanel Margin="0,10,0,0">
          <DockPanel DockPanel.Dock="Top">
            <ComboBox x:Name="InstKindBox" Width="100" SelectedIndex="0" SelectionChanged="InstKind_Changed" HorizontalAlignment="Left">
              <ComboBoxItem Content="模組" Tag="Mod"/>
              <ComboBoxItem Content="光影" Tag="Shader"/>
              <ComboBoxItem Content="資源包" Tag="ResourcePack"/>
            </ComboBox>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
              <Button Content="開啟資料夾" Click="OpenFolder_Click" Padding="10,3" Margin="0,0,6,0"/>
              <Button Content="檢查更新" Click="CheckUpdates_Click" Padding="10,3" Margin="0,0,6,0"/>
              <Button x:Name="UpdateAllBtn" Content="全部更新" Click="UpdateAll_Click" Padding="10,3" IsEnabled="False"/>
            </StackPanel>
          </DockPanel>
          <ListBox ItemsSource="{Binding Installed}" Margin="0,8,0,0" HorizontalContentAlignment="Stretch"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel Margin="0,3">
                  <Button DockPanel.Dock="Right" Content="刪除" Click="DeleteInstalled_Click" Padding="8,2" Margin="8,0,0,0"/>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding Item.SizeText}" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  <TextBlock DockPanel.Dock="Right" Text="{Binding UpdateText}" Foreground="#FF00AAAA" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  <CheckBox IsChecked="{Binding Item.Enabled, Mode=OneWay}" Click="ToggleInstalled_Click" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Item.DisplayName}" TextTrimming="CharacterEllipsis"/>
                  </CheckBox>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
