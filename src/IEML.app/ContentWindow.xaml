<Window x:Class="IEML.App.ContentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模組與內容 (Modrinth)" Width="640" Height="560" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <TextBlock x:Name="Info" DockPanel.Dock="Top" Foreground="Gray" Margin="0,0,0,8"/>
    <DockPanel DockPanel.Dock="Top">
      <Button DockPanel.Dock="Right" Content="搜尋" Click="Search_Click" Padding="14,4" Margin="8,0,0,0" IsDefault="True"/>
      <ComboBox DockPanel.Dock="Left" x:Name="KindBox" Width="100" SelectedIndex="0" Margin="0,0,8,0">
        <ComboBoxItem Content="模組" Tag="Mod"/>
        <ComboBoxItem Content="光影" Tag="Shader"/>
        <ComboBoxItem Content="資源包" Tag="ResourcePack"/>
        <ComboBoxItem Content="整合包" Tag="Modpack"/>
      </ComboBox>
      <TextBox x:Name="QueryBox"/>
    </DockPanel>
    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <ListBox ItemsSource="{Binding Results}" Margin="0,10,0,0" HorizontalContentAlignment="Stretch">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <DockPanel Margin="0,4">
            <Button DockPanel.Dock="Right" Content="安裝" Click="Install_Click" Padding="12,4" VerticalAlignment="Center" Margin="8,0,0,0"/>
            <StackPanel>
              <TextBlock Text="{Binding Title}" FontWeight="Bold"/>
              <TextBlock Text="{Binding Description}" Foreground="Gray" TextWrapping="Wrap"/>
            </StackPanel>
          </DockPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
