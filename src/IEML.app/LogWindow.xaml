<Window x:Class="IEML.App.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="遊戲日誌" Width="860" Height="520" WindowStartupLocation="CenterOwner">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
      <Button Content="清除" Click="Clear_Click" Padding="12,3" Margin="0,0,6,0"/>
      <Button Content="複製全部" Click="Copy_Click" Padding="12,3" Margin="0,0,12,0"/>
      <CheckBox x:Name="AutoScroll" Content="自動捲到最新" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0"/>
      <TextBlock x:Name="CountText" VerticalAlignment="Center" Foreground="Gray"/>
    </StackPanel>
    <TextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas, Microsoft JhengHei UI" FontSize="12"
             TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
  </DockPanel>
</Window>
