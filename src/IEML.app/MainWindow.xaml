<Window x:Class="IEML.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Innovation Easy Minecraft Launcher" Width="980" Height="640">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" BorderBrush="LightGray" BorderThickness="0,1,0,0" Padding="12,8">
      <DockPanel>
        <Button DockPanel.Dock="Left" Content="📁 音樂資料夾" Command="{Binding AddMusicFolderCommand}" Padding="8,2" Margin="0,0,12,0"/>
        <Button DockPanel.Dock="Left" Content="⏮" Command="{Binding PrevMusicCommand}" Width="32"/>
        <Button DockPanel.Dock="Left" Content="▶" Command="{Binding PlayMusicCommand}" Width="32" Margin="4,0"/>
        <Button DockPanel.Dock="Left" Content="⏸" Command="{Binding PauseMusicCommand}" Width="32"/>
        <Button DockPanel.Dock="Left" Content="⏭" Command="{Binding NextMusicCommand}" Width="32" Margin="4,0,12,0"/>
        <Slider DockPanel.Dock="Right" Width="120" Minimum="0" Maximum="1" Value="{Binding MusicVolume}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding MusicTitle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>
    <Grid Margin="12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DockPanel>
        <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
          <Button Content="新增實例" Command="{Binding AddInstanceCommand}" Margin="0,0,6,6" Padding="8,4"/>
          <Button Content="刪除實例" Command="{Binding DeleteInstanceCommand}" Margin="0,0,6,6" Padding="8,4"/>
          <Button Content="新增正版帳號" Command="{Binding AddMicrosoftAccountCommand}" Margin="0,0,6,6" Padding="8,4"/>
          <Button Content="新增離線帳號" Command="{Binding AddOfflineAccountCommand}" Margin="0,0,6,6" Padding="8,4"/>
          <Button Content="刪除帳號" Command="{Binding DeleteAccountCommand}" Margin="0,0,6,6" Padding="8,4"/>
          <Button Content="帳號管理" Command="{Binding OpenAccountsCommand}" Margin="0,0,6,6" Padding="8,4"/>
        </WrapPanel>
        <ListBox ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}" DisplayMemberPath="Name"/>
      </DockPanel>
      <DockPanel Grid.Column="1" Margin="16,0,0,0">
        <StackPanel DockPanel.Dock="Top">
          <TextBlock Text="{Binding SelectedInstance.Name}" FontSize="22" FontWeight="Bold"/>
          <TextBlock Text="{Binding SelectedInstance.McVersion}" Foreground="Gray"/>
          <TextBlock Text="使用帳號" Margin="0,14,0,4"/>
          <ComboBox ItemsSource="{Binding Accounts}" DisplayMemberPath="DisplayName"
                    SelectedItem="{Binding SelectedAccount}" Width="260" HorizontalAlignment="Left"/>
          <WrapPanel Margin="0,18,0,0">
            <Button Content="啟動" Command="{Binding LaunchCommand}" Width="110" Padding="0,8" Margin="0,0,8,0"/>
            <Button Content="實例設置" Command="{Binding OpenSettingsCommand}" Width="110" Padding="0,8" Margin="0,0,8,0"/>
            <Button Content="伺服器查找" Command="{Binding OpenServersCommand}" Width="110" Padding="0,8" Margin="0,0,8,0"/>
            <Button Content="模組與內容" Command="{Binding OpenContentCommand}" Width="110" Padding="0,8"/>
            <Button Content="連線房間" Command="{Binding OpenRoomCommand}" Width="110" Padding="0,8" Margin="8,0,0,0"/>
            <Button Content="遊戲日誌" Command="{Binding OpenLogCommand}" Width="110" Padding="0,8" Margin="8,0,0,0"/>
            <Button Content="種子地圖" Command="{Binding OpenSeedMapCommand}" Width="110" Padding="0,8" Margin="8,0,0,0"/>
            <Button Content="CurseForge" Command="{Binding OpenCurseForgeCommand}" Width="110" Padding="0,8" Margin="8,0,0,0"/>
          </WrapPanel>
          <ProgressBar Value="{Binding ProgressPercent}" Minimum="0" Maximum="100" Height="8" Margin="0,12,0,0">
            <ProgressBar.Style>
              <Style TargetType="ProgressBar">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </ProgressBar.Style>
          </ProgressBar>
          <TextBlock Text="{Binding Status}" Margin="0,6,0,0" Foreground="Gray" TextWrapping="Wrap"/>
          <TextBlock Text="快速啟動" FontWeight="Bold" Margin="0,20,0,6"/>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Cards}">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,10" Width="170">
                <StackPanel>
                  <TextBlock Text="{Binding InstanceName}" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock Text="{Binding AccountName}" Foreground="Gray" Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>
                  <Button Content="用此帳號啟動" Command="{Binding LaunchCommand}" Padding="0,5"/>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
